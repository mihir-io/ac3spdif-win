// Version resource and application icon. The version numbers arrive as /d
// defines from build.ps1, which greps them out of Version.h — the same
// single-source-of-truth arrangement the macOS bundle uses, so the resource
// cannot drift from the binary.

#include <winres.h>

#ifndef APP_VERSION_STR
#define APP_VERSION_STR "0.0.0"
#endif
#ifndef APP_VERSION_COMMAS
#define APP_VERSION_COMMAS 0,0,0,0
#endif

// Generated by scripts/make-icon.ps1 into build/, found via the /i path.
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_COMMAS
 PRODUCTVERSION APP_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Dolby Digital Live for Windows"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "ac3spdif"
            VALUE "OriginalFilename", "AC3SPDIF.exe"
            VALUE "ProductName", "ac3spdif"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
